{
  "name": "T-SQL Learning",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "sqlserver",
  "workspaceFolder": "/workspaces/t-sql-learning",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-mssql.mssql",
        "ms-python.python",
        "jupyter.jupyter"
      ]
    }
  },
  "postCreateCommand": "pip install -r requirements.txt || true"
}